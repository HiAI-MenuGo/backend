# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=debug

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hiai_menugo?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/hiai_menugo?schema=public"
# Seed safety: seed KHÔNG wipe tenant đã có phiên vận hành, trừ khi bật cờ này
# ALLOW_SEED_WIPE=true

# Authentication (Pure JWT)
JWT_SECRET=super_secret_jwt_key_hiai_menugo_2026_dev_mode_only

# Cloudinary (Media Upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SePay / Payment Integration
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=

# MoMo Sandbox (developers.momo.vn -> test keys)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# VNPay Sandbox (sandbox.vnpayment.vn -> test TmnCode/HashSecret)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# URL public để MoMo/VNPay gọi IPN về (chạy local thì dùng ngrok https)
PUBLIC_WEBHOOK_URL=http://localhost:5000

# SMTP Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HiAI-MenuGo <noreply@menu-go.vn>"
